DROIDSHIELD_ENVIRONMENT=development
DROIDSHIELD_DATABASE_URL=sqlite:///./var/droidshield.db
# Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/droidshield
# Exact browser origins only; empty disables cross-origin browser access.
DROIDSHIELD_CORS_ORIGINS=[]
DROIDSHIELD_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
DROIDSHIELD_TOKEN_TTL_HOURS=12
# API and worker must use the same protected root. Use an absolute path in production.
DROIDSHIELD_STORAGE_ROOT=var/artifacts
DROIDSHIELD_MAX_APK_BYTES=104857600
DROIDSHIELD_MAX_CONCURRENT_UPLOADS=2
DROIDSHIELD_UPLOAD_TIMEOUT_SECONDS=120
DROIDSHIELD_SANDBOX_EXECUTABLE=/usr/bin/bwrap
DROIDSHIELD_SANDBOX_PYTHON=/usr/bin/python3
DROIDSHIELD_ANALYSIS_TIMEOUT_SECONDS=30
DROIDSHIELD_ANALYSIS_CPU_SECONDS=15
DROIDSHIELD_ANALYSIS_MEMORY_MB=256
DROIDSHIELD_ANALYSIS_OUTPUT_BYTES=1048576
DROIDSHIELD_APK_MAX_ENTRIES=10000
DROIDSHIELD_APK_MAX_UNCOMPRESSED_BYTES=536870912
DROIDSHIELD_APK_MAX_MANIFEST_BYTES=4194304
DROIDSHIELD_APK_MAX_COMPRESSION_RATIO=100
DROIDSHIELD_WORKER_LEASE_SECONDS=120
DROIDSHIELD_WORKER_HEARTBEAT_SECONDS=1
DROIDSHIELD_WORKER_POLL_SECONDS=0.5
# Bounded instruction inspection in the same isolated static worker.
DROIDSHIELD_DEX_MAX_FILES=16
DROIDSHIELD_DEX_MAX_BYTES=67108864
DROIDSHIELD_DEX_MAX_IDS=100000
DROIDSHIELD_DEX_MAX_CODE_UNITS=4000000
# Optional fixed MobSF service. Do not commit a real URL credential or API key.
# DROIDSHIELD_MOBSF_URL=http://127.0.0.1:8000
# DROIDSHIELD_MOBSF_API_KEY=configure-through-protected-service-environment
DROIDSHIELD_MOBSF_TIMEOUT_SECONDS=180
DROIDSHIELD_MOBSF_MAX_REPORT_BYTES=8388608
# Controlled disposable emulator lab. Empty inventory means no runtime execution.
# See docs/dynamic-lab.md before configuring a new DroidShield_ AVD.
DROIDSHIELD_LAB_DEVICES=[]
DROIDSHIELD_ADB_EXECUTABLE=/usr/bin/adb
DROIDSHIELD_DYNAMIC_TIMEOUT_SECONDS=90
DROIDSHIELD_DYNAMIC_MAX_OUTPUT_BYTES=65536
# No demo users, default tokens, scanner secrets or lab devices are configured.

# Optional fixed Frida native observation on a dedicated, offline AVD.
# Administrator provisions and authenticates the exact matching guest server;
# the worker never downloads/starts it. See docs/frida.md.
DROIDSHIELD_FRIDA_VERSION=17.9.10
# DROIDSHIELD_FRIDA_SERVER_SHA256=verified-lowercase-sha256-of-provisioned-server
# DROIDSHIELD_FRIDA_TOKEN=configure-through-protected-service-environment
# DROIDSHIELD_FRIDA_PYTHON=/absolute/path/to/trusted/python-with-pinned-frida
DROIDSHIELD_FRIDA_OBSERVATION_SECONDS=3
# Optional restricted HTTPS lab proxy; never auto-installs app/device CA trust.
# Create a new directory: droidshield init-proxy-ca --directory /absolute/private/lab-ca
# DROIDSHIELD_PROXY_CA_CERT=/absolute/private/lab-ca/cert.pem
# DROIDSHIELD_PROXY_CA_KEY=/absolute/private/lab-ca/key.pem
DROIDSHIELD_PROXY_OBSERVATION_SECONDS=5
DROIDSHIELD_PROXY_MAX_REQUESTS=20
# Project/workspace-bound credentials: private regular file owned by API/worker,
# mode 0600, no symlink. Ordinary API responses expose only reference names/kinds.
# DROIDSHIELD_API_SECRET_STORE=/absolute/private/api-secrets.json
# Public HTTPS destinations only by default. Add only exact private lab CIDRs;
# example loopback TLS fixture: ["127.0.0.1/32"]. Metadata/link-local remain denied.
DROIDSHIELD_API_ALLOWED_NETWORKS=[]
# Optional administrator CA trust for private upstream HTTPS; verification stays on.
# DROIDSHIELD_API_CA_BUNDLE=/absolute/private/upstream-ca.pem
DROIDSHIELD_API_TIMEOUT_SECONDS=120
DROIDSHIELD_API_REQUEST_TIMEOUT_SECONDS=10
DROIDSHIELD_API_MAX_RESPONSE_BYTES=65536
DROIDSHIELD_API_MAX_REQUESTS=60
